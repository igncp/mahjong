FROM alpine:3.20.2 AS backend
ARG TARGETARCH
COPY build/mahjong-service-closure-${TARGETARCH} /nix/store
RUN mkdir -p /app \
  && cp /nix/store/*-mahjong-service-0.1.0/bin/mahjong_service /app/mahjong_service

FROM alpine:3.20.2
WORKDIR /app
RUN apk add --no-cache ca-certificates
COPY --from=backend /nix/store /nix/store
COPY --from=backend /app/mahjong_service .
COPY ./web_client/out static

CMD ["./mahjong_service"]
